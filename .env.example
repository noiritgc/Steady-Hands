# Copy to .env (git-ignored) and fill in, or set these in your shell environment instead.
# Cartesia API key from https://play.cartesia.ai (starts with sk_car_). Used only by server.js, never sent to the browser.
CARTESIA_API_KEY=
# Optional: a voice ID from the Cartesia playground. If empty, Riley uses "Clive" (composed, articulate, British).
CARTESIA_VOICE_ID=
# Optional: TTS model (sonic-3.6 by default).
CARTESIA_MODEL=sonic-3.6
